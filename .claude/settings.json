{
  "permissions": {
    "allow": [
      "Bash(bash .claude/preamble.sh:*)",
      "Bash(bash \"C:/Users/moont/live projects/Colony Viewer/.claude/preamble.sh\":*)",
      "Bash(make *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm build)",
      "Bash(pnpm test *)",
      "Bash(pytest *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Read(*)",
      "Grep(*)",
      "Glob(*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/filesize.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "sed -n '/## Current/,/## Deferred/p' PROGRESS.md 2>/dev/null; echo 'Path-scoped rules in .claude/rules/ are NOT auto-reloaded after compaction. Re-read the relevant one before continuing Tier 1 work.'"
          }
        ]
      }
    ]
  }
}
