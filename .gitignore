# --- apps/map (React PWA, pnpm) ---
apps/map/node_modules/
apps/map/dist/
apps/map/build/
apps/map/.vite/
apps/map/coverage/
apps/map/*.local
apps/map/.env
apps/map/.env.*
!apps/map/.env.example
apps/map/supabase/.branches/
apps/map/supabase/.temp/

# --- tools/pipeline (Python) ---
tools/pipeline/.venv/
tools/pipeline/__pycache__/
tools/pipeline/**/__pycache__/
tools/pipeline/*.egg-info/
tools/pipeline/.pytest_cache/
tools/pipeline/.mypy_cache/
tools/pipeline/.ruff_cache/
tools/pipeline/out/

# tools/pipeline/overrides/ is intentionally NOT ignored (D-107):
# hand-made corrections keyed by centroid, cannot be regenerated.

# --- tools/cad-lisp (standalone Python script, close_polygons.py) ---
tools/cad-lisp/__pycache__/
tools/cad-lisp/.venv/

# --- client-provided source documents dropped at repo root, not project source ---
# (root-level only -- fixtures/*.pdf are real, tracked fixtures, not ignored by this)
/*.pdf

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- misc build artifacts ---
*.log
npm-debug.log*

# --- throwaway perf harness (2026-08-22 pan/zoom investigation) ---
# Lives under public/ only because the guard hook reserves servers for the owner and the
# already-running dev server is the one way to give it an http origin. It ships into
# dist/ if a build runs while it exists — delete the directory before the next deploy.
apps/map/public/_bench/
