VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Node-only (scripts/import-seed.ts, scripts/create-user.ts, live-integration tests).
# Never VITE_-prefixed — must never reach import.meta.env/the browser bundle (D-019,
# docs/plans/09.md). Get the local value from `supabase status -o env` after `make db-up`.
SUPABASE_SERVICE_ROLE_KEY=

# Admin portal (docs/plans/36.md). SUPABASE_URL / SUPABASE_ANON_KEY fall back to the VITE_*
# values above. The portal needs a login: run `pnpm grant-super-admin <username>` once per
# Supabase project. ADMIN_HOST defaults to 127.0.0.1 (never 0.0.0.0 unless set on purpose).
SUPABASE_URL=
SUPABASE_ANON_KEY=
ADMIN_HOST=127.0.0.1
ADMIN_PORT=5002
