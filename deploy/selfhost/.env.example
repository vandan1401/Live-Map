# Copy-free setup: scripts/gen-secrets.sh writes the real `.env` from this file, generating every
# value marked __GENERATE__ fresh. Never use the example values from Supabase's own sample .env.
# `.env` is gitignored and chmod 600; only this example is committed.

# --- compose layering (do not change) -------------------------------------------------------
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.kong.yml:docker-compose.pg15.yml:docker-compose.selfhost.yml

# --- release + paths ------------------------------------------------------------------------
# GitHub user/org that owns the ghcr.io images (lowercase).
GHCR_OWNER=
# Image tag every app container runs; update.sh changes this.
RELEASE_VERSION=
# Where data lives on the SSD: ${DATA_DIR}/db, ${DATA_DIR}/storage.
DATA_DIR=/srv/naksha
# External backup drive mount point; backup.sh refuses to write elsewhere (see scripts/backup.sh).
BACKUP_DIR=/mnt/naksha-backup
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8

# --- hostnames (single-level subdomains only: Cloudflare's free certificate does not cover
# api.client.example.com). Filled in by gen-secrets.sh --app-host / --api-host.
APP_HOST=
API_HOST=
SUPABASE_PUBLIC_URL=
API_EXTERNAL_URL=
SITE_URL=
ADDITIONAL_REDIRECT_URLS=

# --- secrets (generated) ----------------------------------------------------------------------
POSTGRES_PASSWORD=__GENERATE__
JWT_SECRET=__GENERATE__
ANON_KEY=__GENERATE__
SERVICE_ROLE_KEY=__GENERATE__
DASHBOARD_USERNAME=naksha
DASHBOARD_PASSWORD=__GENERATE__
SECRET_KEY_BASE=__GENERATE__
REALTIME_DB_ENC_KEY=__GENERATE__
VAULT_ENC_KEY=__GENERATE__
PG_META_CRYPTO_KEY=__GENERATE__
S3_PROTOCOL_ACCESS_KEY_ID=__GENERATE__
S3_PROTOCOL_ACCESS_KEY_SECRET=__GENERATE__

# Opaque/asymmetric keys are not used (legacy HS256 keys only); kept empty on purpose.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# --- Auth -------------------------------------------------------------------------------------
# Public signup OFF. Accounts exist only because the super-admin service created them.
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
# No SMTP anywhere: accounts are created pre-confirmed (email_confirm) with a password the
# operator sets. The SMTP_* values below are inert placeholders the base compose file requires.
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
JWT_EXPIRY=3600
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"
SMTP_ADMIN_EMAIL=admin@localhost.invalid
SMTP_HOST=localhost.invalid
SMTP_PORT=2500
SMTP_USER=unused
SMTP_PASS=unused
SMTP_SENDER_NAME=unused

# --- Postgres / PostgREST / Storage / Studio (upstream defaults, not secrets) -----------------
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
STUDIO_DEFAULT_ORGANIZATION=Naksha
STUDIO_DEFAULT_PROJECT=Private instance
OPENAI_API_KEY=
FUNCTIONS_VERIFY_JWT=false
IMGPROXY_AUTO_WEBP=true

# Referenced by the base compose file even though these services are disabled (profile "unused").
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=naksha
POOLER_DB_POOL_SIZE=5
API_GW_HTTP_PORT=8000
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
