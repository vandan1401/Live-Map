{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colony.local/colony.schema.json",
  "title": "Colony manifest",
  "type": "object",
  "required": ["colony", "plots", "features"],
  "additionalProperties": false,
  "properties": {
    "colony": {
      "type": "object",
      "required": ["id", "name", "viewbox", "scale", "north_deg", "generated", "verified", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "viewbox": {
          "type": "array", "items": { "type": "number" },
          "minItems": 4, "maxItems": 4,
          "description": "Always [0, 0, 1000, H]. Width is fixed so the app needs no per-colony constants."
        },
        "scale": {
          "type": "object", "required": ["px_per_ft"],
          "properties": { "px_per_ft": { "type": "number", "exclusiveMinimum": 0 } }
        },
        "select_zoom": {
          "type": "object", "required": ["ref_width_px", "ref_height_px"],
          "properties": {
            "ref_width_px": { "type": "number", "exclusiveMinimum": 0 },
            "ref_height_px": { "type": "number", "exclusiveMinimum": 0 }
          },
          "description": "Optional. Present only when the source DXF has a COL-ZOOM-REF rectangle. apps/map uses this to compute the click-to-focus zoom instead of a fixed default."
        },
        "backdrop": {
          "type": "object",
          "required": ["transform", "darken_alpha", "enabled_on_admin", "enabled_on_public", "attribution"],
          "properties": {
            "transform": {
              "type": "object",
              "required": ["x", "y", "scale", "rotate_deg"],
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" },
                "scale": { "type": "number", "exclusiveMinimum": 0 },
                "rotate_deg": { "type": "number" }
              }
            },
            "darken_alpha": { "type": "number", "minimum": 0, "maximum": 1 },
            "enabled_on_admin": { "type": "boolean" },
            "enabled_on_public": { "type": "boolean" },
            "attribution": { "type": "string" }
          },
          "description": "Optional. When present, this is the AUTHORITATIVE alignment for this colony's synthetic-aerial backdrop (D-036/D-047/D-048/D-049), applied on every upload/replace, overwriting whatever the colony currently has -- omit this key entirely to leave an existing backdrop untouched. A backdrop has no DXF source, so tools/pipeline cannot derive it -- but it does propagate it: declare it once in tools/pipeline/colonies/<id>.json (the hand-maintained ColonyConfig input, never regenerated by a run) and every make export carries it through into the exported colony.json verbatim -- unlike select_zoom, which is genuinely derived from COL-ZOOM-REF, this is a plain passthrough of whatever the config declares, with nothing in the drawing to compute, constrain or validate it against. Once that config file declares backdrop, IT is the value's home, not the database -- an adjustment made afterwards in the app's own backdrop form must be copied back into the config or the next export/upload silently reverts it; deleting the block from the config hands the value back to the UI. attribution is required, not optional, specifically so an omitted credit is a validation error, not a silently blanked column."
        },
        "north_deg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
        "generated": { "type": "string", "format": "date" },
        "verified": {
          "type": "boolean",
          "description": "False until a human passes the verify page. The app refuses false. D-108."
        },
        "note": { "type": "string" },
        "source": {
          "type": "object",
          "required": ["file", "revision", "plan_date", "method"],
          "properties": {
            "file": { "type": "string" },
            "revision": { "type": "string" },
            "plan_date": { "type": "string" },
            "method": { "enum": ["vector-pdf", "raster", "traced", "dxf", "hand-authored fixture"] },
            "note": { "type": "string" }
          }
        }
      }
    },
    "plots": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["svg_id", "block", "number", "area_sqft", "length_ft", "breadth_ft", "centroid", "facing", "is_corner"],
        "additionalProperties": false,
        "properties": {
          "svg_id": { "type": "string", "pattern": "^plot-(?:[A-Z]+-)?[0-9]{2,}$" },
          "block": { "type": "string", "pattern": "^[A-Z]*$" },
          "number": { "type": "string", "pattern": "^[0-9]{2,}$" },
          "area_sqft": { "type": "integer", "exclusiveMinimum": 0 },
          "length_ft": { "type": "number", "exclusiveMinimum": 0 },
          "breadth_ft": { "type": "number", "exclusiveMinimum": 0 },
          "centroid": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "facing": { "enum": ["north", "north-east", "east", "south-east",
                               "south", "south-west", "west", "north-west"] },
          "is_corner": { "type": "boolean" },
          "confidence": { "enum": ["contained", "nearest", "manual"] }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["svg_id", "class", "kind", "label", "centroid"],
        "additionalProperties": false,
        "properties": {
          "svg_id": { "type": "string" },
          "class": { "enum": ["garden", "amenity", "water"] },
          "kind": { "enum": ["park", "clubhouse", "temple", "tank", "playground", "parking", "reserved", "other"] },
          "label": { "type": "string" },
          "centroid": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "area_sqft": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
